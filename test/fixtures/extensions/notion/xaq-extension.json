{
  "schema": 1,
  "name": "notion",
  "displayName": "Notion",
  "version": "1.0.0",
  "description": "Notion's hosted MCP server: search, read and edit pages, databases and comments in a workspace you choose. Sign in with Notion; nothing to set up.",
  "kind": "remote",
  "slug": "notion",
  "remote": {
    "url": "https://mcp.notion.com/mcp",
    "auth": { "type": "mcp_oauth" }
  },
  "reconnectPolicy": { "maxLifetimeDays": 180, "idleDays": 30 },
  "setup": [
    {
      "id": "connect",
      "title": "Connect",
      "body": "Press Connect and we'll open Notion's sign-in. There's no app to create and nothing to copy."
    },
    {
      "id": "approve",
      "title": "In Notion, choose the workspace and approve",
      "body": "Pick the workspace your agents should use and approve. Agents can then reach what you can see in that workspace, limited by the access level you choose next. On Business and Enterprise plans a workspace owner controls which MCP clients may connect (in Notion: Settings, Notion MCP, Manage workspace clients). If Notion refuses the connection, ask an owner to allow it."
    },
    {
      "id": "reconnect",
      "title": "Reconnect every 180 days",
      "body": "Notion asks you to reconnect at least every 180 days, and after 30 days without use. We'll remind you before that happens; reconnecting is the same two steps."
    }
  ],
  "risk": {
